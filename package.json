  },
  "devDependencies": {
    "@tinacms/cli": "4.0.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "js-yaml": "4.3.2",
    "typescript": "^5.9.0",
    "esbuild": "0.28.2",
    "graphql": "15.8.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
